[user]
	name = XADE
	email = notadevel@gmail.com
[core]
	excludesfile = ~/.config/git/.gitignore_global
	editor = helix
	autocrlf = input
[fetch]
  # Delete out deleted branch during fetch
	prune = true
[init]
	defaultBranch = main
[status]
	short = true
[credential]
	helper = store
[http]
	postBuffer = 157286400
[credential "https://github.com"]
	helper = 
	helper = !/nix/store/bsjdf8dh5k8sylwzgp58ip47sbpbzw5l-gh-2.101.0/bin/.gh-wrapped auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/nix/store/bsjdf8dh5k8sylwzgp58ip47sbpbzw5l-gh-2.101.0/bin/.gh-wrapped auth git-credential
