{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m3.1-flash-free",
  "small_model": "opencode/nemotron-3.5-super-vl-free",
  "enabled_providers": [
    "opencode"
  ],
  "autoupdate": "notify",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--headless"
      ],
      "enabled": true
    }
  }
}
